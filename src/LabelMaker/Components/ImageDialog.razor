@implements IDisposable
@inject Library Lib
@inject Editor Ed
@inject Shell Shell
@inject IJSRuntime JS

<div class="scrim">
    <div class="dialog">
        <div class="dhead">
            <div class="tabs">
                <button class="tab @(_icons ? "" : "on")" @onclick="() => _icons = false">My images</button>
                <button class="tab @(_icons ? "on" : "")" @onclick="() => _icons = true">Icons</button>
            </div>
            <span class="grow"></span>
            @if (!_icons)
            {
                <button class="btn sm" title="Add pictures or SVG files to your library" @onclick="AddFiles"><Icon Name="plus" />Add images…</button>
            }
            <button class="ibtn" title="Close" @onclick="Shell.Close"><Icon Name="x" /></button>
        </div>

        @if (_icons)
        {
            <div class="icon-search">
                <input id="icon-query" class="inp" spellcheck="false" placeholder="Search icons: warning, wifi, arrow, ethernet…" value="@_query"
                       @oninput="OnQuery" />
                <span class="hint" style="margin:0;min-width:64px">@(_busy ? "Searching…" : "")</span>
                <label class="check" title="Leave out multi-colour sets such as emoji and logos, which can only print as a dither">
                    <input type="checkbox" checked="@Shell.Settings.IconsMono" @onchange="SetMono" /><i></i>
                    One colour only
                </label>
            </div>
        }

        <div class="dbody" style="min-height:300px">
            @if (!_icons)
            {
                @if (_images.Count == 0)
                {
                    <div class="empty">
                        Nothing here yet. Add logos, symbols or SVG files you reuse, and place them on any label from this list.
                        They are stored in this browser only.
                    </div>
                }
                <div class="cards small">
                    @foreach (var i in _images)
                    {
                        var image = i;
                        <div class="card">
                            <button class="card-thumb" title="Place on the label" @onclick="() => Place(image.DataUrl, image.W, image.H)">
                                <img src="@image.DataUrl" alt="" />
                            </button>
                            <div class="card-meta">
                                <input class="inp bare" spellcheck="false" value="@image.Name" title="Rename" @onchange="e => Lib.RenameImage(image, e.Value?.ToString() ?? string.Empty)" />
                                @if (image.IsVector) { <span class="tag">SVG</span> }
                                <button class="ibtn sm" title="Remove from the library (labels that use it keep their copy)" @onclick="() => Lib.DeleteImage(image.Id)"><Icon Name="trash" /></button>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                @if (_error is not null) { <div class="warn" style="margin:0 0 10px">@_error</div> }
                @if (_results is null)
                {
                    <div class="empty">
                        Start typing to search the open-source icon sets collected by Iconify (Material, Tabler, Lucide, Phosphor and many more).
                        An icon is placed as a vector, so it prints sharp at any size.
                    </div>
                }
                else if (_results.Count == 0) { <div class="empty">No icon matches “@_searched”.</div> }
                else
                {
                    <div class="icon-grid" style="@(_busy ? "opacity:.5" : "")">
                        @foreach (var item in _results)
                        {
                            var icon = item;
                            <button title="@icon.Id" @onclick="() => PlaceIcon(icon)">
                                <img src="@icon.DataUrl" alt="@icon.Id" />
                            </button>
                        }
                    </div>
                    @if (_total > _results.Count) { <div class="hint">Showing the first @_results.Count matches. Add a word to narrow the search.</div> }
                }
            }
        </div>

        <div class="dfoot">
            @if (_icons)
            {
                <label class="check">
                    <input type="checkbox" checked="@Shell.Settings.KeepIcons" @onchange="e => { Shell.Settings.KeepIcons = (bool)e.Value!; Shell.SaveSettings(); }" /><i></i>
                    Also keep icons I place in My images
                </label>
                <span class="grow"></span>
                <span class="hint" style="margin:0">Searches go to api.iconify.design. Each icon set has its own open licence.</span>
            }
            else
            {
                <span class="hint" style="margin:0">Click a picture, then click or drag on the label to place it.</span>
                <span class="grow"></span>
                <span class="hint" style="margin:0">Included in Library → Export all.</span>
            }
        </div>
    </div>
</div>

@code {
    sealed class IconItem
    {
        public string Id { get; set; } = "";
        public string DataUrl { get; set; } = "";
        public double W { get; set; }
        public double H { get; set; }
    }

    sealed class IconResult
    {
        public List<IconItem> Icons { get; set; } = new();
        public int Total { get; set; }
        public string? Error { get; set; }
        /// <summary>Newer typing overtook this search; ignore it.</summary>
        public bool Stale { get; set; }
    }

    // the last search survives closing the dialog
    static string _query = "", _searched = "";
    static List<IconItem>? _results;
    static int _total;

    bool _icons, _busy;
    string? _error;
    CancellationTokenSource? _typing;
    List<StoredImage> _images = new();

    protected override async Task OnInitializedAsync()
    {
        _icons = Shell.Dialog == Dialog.Icons;
        Lib.ImagesChanged += Reload;
        await Load();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _icons) await JS.InvokeVoidAsync("LM.focus", "#icon-query", true);
    }

    async Task Load()
    {
        _images = await Lib.ListImages();
        StateHasChanged();
    }

    void Reload() => _ = InvokeAsync(Load);

    async Task AddFiles()
    {
        int n = await Lib.AddImageFiles();
        if (n > 0) Shell.Toast(n == 1 ? "Image added to your library." : $"{n} images added to your library.");
    }

    void Place(string dataUrl, double w, double h)
    {
        Shell.Close();
        Ed.SetImageTool(dataUrl, w, h);
    }

    Task OnQuery(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;
        return SearchSoon();
    }

    Task SetMono(ChangeEventArgs e)
    {
        Shell.Settings.IconsMono = (bool)e.Value!;
        Shell.SaveSettings();
        return SearchSoon(0);
    }

    // Wait for a pause in the typing, so each word costs one search rather than one per letter.
    async Task SearchSoon(int delay = 450)
    {
        _typing?.Cancel();
        var cts = _typing = new CancellationTokenSource();
        string q = _query.Trim();
        if (q.Length < 2) { _busy = false; return; }
        try { await Task.Delay(delay, cts.Token); } catch (TaskCanceledException) { return; }

        _busy = true; _error = null;
        StateHasChanged();
        var r = await JS.InvokeAsync<IconResult>("LM.iconSearch", q, Shell.Settings.IconsMono);
        if (r.Stale || cts.IsCancellationRequested) return;
        _busy = false;
        _error = r.Error;
        if (r.Error is null) { _searched = q; _results = r.Icons; _total = r.Total; }
    }

    async Task PlaceIcon(IconItem icon)
    {
        if (Shell.Settings.KeepIcons) await Lib.AddImage(icon.Id.Replace(':', ' '), icon.DataUrl, icon.W, icon.H);
        Place(icon.DataUrl, icon.W, icon.H);
    }

    public void Dispose()
    {
        _typing?.Cancel();
        Lib.ImagesChanged -= Reload;
    }
}
