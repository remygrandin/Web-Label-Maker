@inherits EditorComponent
@inject IJSRuntime JS

<aside class="panel insp">
    @{ var nodes = Ed.SelectedNodes.ToList(); var one = nodes.Count == 1 ? nodes[0] : null; }

    @if (nodes.Count == 0)
    {
        <div class="phead">Label</div>
        <DocumentInspector />
    }
    else
    {
        <div class="phead">
            @(one is null ? "Selection" : TypeName(one))
            @if (one is null) { <span class="count">@nodes.Count objects</span> }
            <span class="grow"></span>
            <button class="ibtn sm" title="Duplicate (Ctrl+D)" @onclick="Ed.Duplicate"><Icon Name="copy" /></button>
            <button class="ibtn sm" title="Delete (Del)" @onclick="Ed.DeleteSelection"><Icon Name="trash" /></button>
        </div>

        @if (one is not null)
        {
            <div class="sect" style="padding-bottom:10px">
                <div class="row">
                    <span class="lbl">Name</span>
                    <input class="inp fill" spellcheck="false" placeholder="@Editor.DisplayName(one)" value="@one.Name" title="Other objects can refer to this one by name, e.g. {@(one.Name.Length > 0 ? one.Name : "Title").w}"
                           @onchange="e => Ed.Rename(one, Editor.CleanName(e.Value?.ToString() ?? string.Empty))" />
                </div>
            </div>
        }

        <ArrangeSection />

        <div class="sect">
            <div class="sect-title">Geometry</div>
            @if (one is not null and not GroupNode)
            {
                bool auto = one is TextNode { Mode: TextMode.Auto };
                bool line = one is ShapeNode { Kind: ShapeKind.Line };
                bool forced = auto || one is BarcodeNode { Is2D: true };
                <div class="grid2">
                    <BoundField Node="one" Prop="X" Label="X" Unit="mm" Step="0.5" />
                    <BoundField Node="one" Prop="Y" Label="Y" Unit="mm" Step="0.5" />
                </div>
                <div class="row">
                    <div class="fill"><BoundField Node="one" Prop="W" Label="W" Unit="mm" Apply="v => SetSize(one, v, true)" Min="0.3" Step="0.5" Disabled="auto" /></div>
                    <button class="ibtn sm @(one.LockAspect || forced ? "on" : "")" disabled="@(forced || line)"
                            title="@(forced ? "Proportions are always kept for this object" : one.LockAspect ? "Proportions locked: width and height change together. Click to unlock." : "Lock proportions")"
                            @onclick="() => Ed.Mutate(() => one.LockAspect = !one.LockAspect)"><Icon Name="link" /></button>
                    <div class="fill"><BoundField Node="one" Prop="H" Label="H" Unit="mm" Apply="v => SetSize(one, v, false)" Min="0.3" Step="0.5" Disabled="auto || line" /></div>
                </div>
                <div class="grid2">
                    <BoundField Node="one" Prop="Rotation" Label="∠" Unit="°" Apply="v => Rotate(one, v)" Step="15" Decimals="1" />
                    <div class="seg fill">
                        <button title="Rotate 90° left" @onclick="() => Rotate(one, one.Rotation - 90)">−90°</button>
                        <button title="Rotate 90° right" @onclick="() => Rotate(one, one.Rotation + 90)">+90°</button>
                    </div>
                </div>
            }
            else if (Geo.Bounds(nodes) is { } b)
            {
                <div class="grid2">
                    <NumberField Label="X" Unit="mm" Value="b.X" ValueChanged="v => MoveAll(nodes, v - b.X, 0)" Step="0.5" />
                    <NumberField Label="Y" Unit="mm" Value="b.Y" ValueChanged="v => MoveAll(nodes, 0, v - b.Y)" Step="0.5" />
                </div>
                <div class="grid2">
                    <NumberField Label="W" Unit="mm" Value="b.W" Disabled="true" />
                    <NumberField Label="H" Unit="mm" Value="b.H" Disabled="true" />
                </div>
            }
        </div>

        @switch (one)
        {
            case TextNode t: <TextInspector Node="t" /> break;
            case ShapeNode s: <ShapeInspector Node="s" /> break;
            case ImageNode i: <ImageInspector Node="i" /> break;
            case BarcodeNode c: <BarcodeInspector Node="c" /> break;
        }
    }
</aside>

@code {
    static string TypeName(Node n) => n switch
    {
        TextNode => "Text",
        ShapeNode s => s.Kind == ShapeKind.Rect ? "Rectangle" : s.Kind.ToString(),
        ImageNode => "Image",
        BarcodeNode b => CodeNames.Of(b.Format),
        GroupNode => "Group",
        _ => "Object",
    };

    void SetSize(Node n, double v, bool width) => Ed.Mutate(() =>
    {
        bool uniform = n.LockAspect || n is BarcodeNode { Is2D: true };
        double k = v / (width ? n.W : n.H);
        if (width || uniform) n.W = width ? v : n.W * k;
        if (!width || uniform) n.H = width ? n.H * k : v;
    });

    void Rotate(Node n, double deg) => Ed.Mutate(() =>
    {
        double cx = n.Cx, cy = n.Cy;
        n.Rotation = Geo.Norm(deg);
        n.X = cx - n.W / 2; n.Y = cy - n.H / 2;
    });

    void MoveAll(List<Node> nodes, double dx, double dy) => Ed.Mutate(() => nodes.ForEach(n => Geo.Translate(n, dx, dy)));
}
