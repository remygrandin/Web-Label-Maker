@inherits EditorComponent

@{ var doc = Ed.Doc; var media = Media.Get(doc.MediaId); var m = doc.Margins; bool inLayout = doc.Layout.Kind != "none"; }

<div class="sect">
    <div class="sect-title">Tape</div>
    <div class="row">
        <span class="lbl">Width</span>
        <select @key="_tapeKey" class="sel fill" value="@doc.MediaId" @onchange="e => ChangeTape(e.Value!.ToString()!)">
            @foreach (var t in Media.All)
            {
                <option value="@t.Id">TZe @t.Label</option>
            }
        </select>
    </div>
    <div class="row">
        <span class="lbl">Colours</span>
        <select class="sel fill" title="Tape colour (preview only: the printer prints on whatever tape is loaded)" value="@doc.TapeColor" @onchange="e => Ed.Mutate(() => doc.TapeColor = e.Value!.ToString()!)">
            @foreach (var c in Media.TapeColors) { <option value="@c.Id">@c.Label tape</option> }
        </select>
        <select class="sel fill" title="Print colour" value="@doc.InkColor" @onchange="e => Ed.Mutate(() => doc.InkColor = e.Value!.ToString()!)">
            @foreach (var c in Media.InkColors) { <option value="@c.Id">@c.Label print</option> }
        </select>
        <span class="tape-chip" title="@Media.InkColors.First(c => c.Id == doc.InkColor).Label on @Media.TapeColors.First(c => c.Id == doc.TapeColor).Label.ToLowerInvariant()"
              style="background:@Media.Hex(Media.TapeColors, doc.TapeColor);color:@Media.Hex(Media.InkColors, doc.InkColor)">Aa</span>
    </div>
    <div class="row">
        <span class="lbl"></span>
        <label class="check" title="Prints the area inside the margins solid and leaves the content blank: white on black with standard tape">
            <input type="checkbox" checked="@doc.Invert" @onchange="e => Ed.Mutate(() => doc.Invert = (bool)e.Value!)" /><i></i>
            Negative print
        </label>
    </div>
    <div class="row">
        <span class="lbl">Length</span>
        <div class="seg fill">
            <button class="@(doc.AutoWidth || inLayout ? "" : "on")" disabled="@inLayout" title="The label keeps the length you set" @onclick="() => SetAuto(false)">Fixed</button>
            <button class="@(doc.AutoWidth && !inLayout ? "on" : "")" disabled="@inLayout" title="The label grows and shrinks to fit its content" @onclick="() => SetAuto(true)">Auto</button>
        </div>
    </div>
    <div class="row">
        <span class="lbl"></span>
        <div class="fill">
            <NumberField Unit="mm" Value="doc.WidthMm" Min="5" Max="1000" Step="1" Decimals="1" Disabled="doc.AutoWidth || inLayout"
                         Title="@(inLayout ? "Set by the layout below" : doc.AutoWidth ? "Set by the content, plus the right margin" : "Label length")"
                         ValueChanged="v => { Ed.Mutate(() => doc.WidthMm = v); Ed.ZoomToFit(); }" />
        </div>
    </div>
    <div class="hint">
        @media.Label tape prints a @media.PrintableMm.ToString("0.0", CultureInfo.InvariantCulture) mm band.
        At @doc.Dpi dpi this label is @Px(doc.WidthMm) × @Px(doc.HeightMm) dots.
    </div>
</div>

<LayoutSection />

<div class="sect">
    <div class="sect-title">
        Margins
        <span class="grow"></span>
        <button class="btn sm" title="Margins matching the printer's unprintable area" @onclick="ResetMargins">Printer default</button>
    </div>
    <div class="grid2">
        <NumberField Label="L" Unit="mm" Value="m.L" Min="0" Max="50" Step="0.5" ValueChanged="v => Ed.Mutate(() => m.L = v)" />
        <NumberField Label="R" Unit="mm" Value="m.R" Min="0" Max="50" Step="0.5" ValueChanged="v => Ed.Mutate(() => m.R = v)" />
    </div>
    <div class="grid2">
        <NumberField Label="T" Unit="mm" Value="m.T" Min="0" Max="20" Step="0.25" ValueChanged="v => Ed.Mutate(() => m.T = v)" />
        <NumberField Label="B" Unit="mm" Value="m.B" Min="0" Max="20" Step="0.25" ValueChanged="v => Ed.Mutate(() => m.B = v)" />
    </div>
</div>

<div class="sect">
    <div class="sect-title">
        Variables
        <span class="grow"></span>
        <button class="btn sm" @onclick="Ed.AddVariable"><Icon Name="plus" />Add</button>
    </div>
    @foreach (var v in doc.Variables)
    {
        var item = v;
        <div class="row">
            <input class="inp mono" style="width:86px;flex:none" spellcheck="false" placeholder="name" value="@item.Name" title="Use it as {@item.Name}"
                   @onchange="e => Ed.Mutate(() => item.Name = Editor.CleanName(e.Value?.ToString() ?? string.Empty))" />
            <input class="inp fill" spellcheck="false" placeholder="value" value="@item.Value"
                   @oninput="e => Ed.Mutate(() => item.Value = e.Value?.ToString() ?? string.Empty, VarKey(item))" />
            <button class="ibtn sm" title="Remove variable" @onclick="() => Ed.RemoveVariable(item)"><Icon Name="x" /></button>
        </div>
    }
    <div class="hint">
        Write <b>{name}</b> in any text or code value. Numeric fields accept names and maths directly, such as
        <b>gap * 2</b> or <b>Title.right + 1</b> (a property of the object named Title: x, y, w, h, right, bottom, cx, cy, fontSize…).
    </div>
</div>

<div class="sect">
    <div class="sect-title">Counter</div>
    <div class="grid2">
        <NumberField Label="NEXT" Value="doc.Counter.Value" Step="1" Decimals="0" Title="The value {seq} shows now and the first one printed"
                     ValueChanged="v => Ed.Mutate(() => doc.Counter.Value = v)" />
        <NumberField Label="STEP" Value="doc.Counter.Step" Step="1" Decimals="0" Title="Added for every printed copy"
                     ValueChanged="v => Ed.Mutate(() => doc.Counter.Step = v)" />
    </div>
    <div class="hint">
        <b>{seq}</b> numbers each printed copy; <b>{seq:0000}</b> pads with zeros. The counter moves on after printing.
    </div>
</div>

<div class="sect">
    <div class="sect-title">
        Cut marks
        <span class="grow"></span>
        <button class="btn sm" title="Add a full cut in the middle of the label" @onclick="() => Ed.AddCut(doc.WidthMm / 2, false)"><Icon Name="cut" />Add</button>
    </div>
    @foreach (var c in doc.Cuts)
    {
        var cut = c;
        <div class="row">
            <div style="width:96px;flex:none">
                <NumberField Label="AT" Unit="mm" Value="cut.X" Min="1" Max="@(doc.WidthMm - 1)" Step="0.5" Decimals="1" ValueChanged="v => Ed.Mutate(() => cut.X = v)" />
            </div>
            <div class="seg fill">
                <button class="@(cut.Half ? "" : "on")" title="Cut through tape and backing" @onclick="() => Ed.Mutate(() => cut.Half = false)">Full</button>
                <button class="@(cut.Half ? "on" : "")" title="Cut the tape only; the backing keeps the pieces together" @onclick="() => Ed.Mutate(() => cut.Half = true)">Half</button>
            </div>
            <button class="ibtn sm" title="Remove cut mark" @onclick="() => Ed.RemoveCut(cut)"><Icon Name="x" /></button>
        </div>
    }
    <div class="hint">
        @(doc.Cuts.Count == 0
            ? "Cut the label into pieces while it prints. Use the scissors tool, or Add, then drag the mark's tab above the label."
            : "The printer needs blank feed either side of a cut; the print preview shows what is lost.")
    </div>
</div>

@code {
    int Px(double mm) => (int)Math.Round(mm * Ed.Doc.Dpi / 25.4);

    static string VarKey(Variable v) => "var:" + v.Name;

    int _tapeKey;

    // A label with content can either be resized with the tape or keep its sizes: ask.
    async Task ChangeTape(string id)
    {
        if (!await Ed.ChangeTape(id)) { _tapeKey++; StateHasChanged(); } // cancelled: put the selector back
    }

    void SetAuto(bool auto)
    {
        if (Ed.Doc.AutoWidth == auto) return;
        Ed.Mutate(() => Ed.Doc.AutoWidth = auto);
        Ed.ZoomToFit();
    }

    void ResetMargins() => Ed.Mutate(() => Ed.Doc.Margins = Media.DefaultMargins(Media.Get(Ed.Doc.MediaId)));
}
