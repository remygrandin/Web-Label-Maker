@implements IDisposable
@inject IJSRuntime JS
@inject Editor Ed

<main class="stage @(Ed.Tool is not null ? "arming" : "")">
    <canvas @ref="_canvas"></canvas>
    @if (Ed.EditingNode is { } t)
    {
        <textarea id="inline-text" class="inline-text" spellcheck="false" style="@EditorStyle(t)" value="@t.Text"
                  @oninput="e => Ed.Mutate(() => t.Text = e.Value?.ToString() ?? string.Empty, Key(t))"
                  @onblur="Ed.EndEdit" @onkeydown="OnEditKey"></textarea>
    }
    @if (Ed.EditingTable is { } table)
    {
        int index = Ed.CellIndex;
        <input id="cell-text" class="inline-text cell" spellcheck="false" autocomplete="off" style="@CellStyle(table, index)" value="@table.Cell(index)"
               @oninput="e => Ed.SetCell(table, index, e.Value?.ToString() ?? string.Empty)"
               @onblur="Ed.EndCellEdit" @onkeydown="OnCellKey" />
    }
    @if (Ed.Tool is not null)
    {
        <div class="tool-hint">@Hint</div>
    }
</main>

@code {
    ElementReference _canvas;
    DotNetObjectReference<CanvasView>? _ref;
    string? _focused, _cell;

    static string Key(TextNode t) => "text:" + t.Id;

    string Hint => Ed.Tool switch
    {
        "text" => "Click to add text, or drag out a box · Esc to cancel",
        "image" => "Drag to place the image, or click for the default size · Esc to cancel",
        var c when c!.StartsWith("cut:") => "Click on the label where the tape should be cut · Esc to cancel",
        _ => "Drag to draw, or click for the default size · Shift keeps it square · Alt draws from the centre · Esc to cancel",
    };

    protected override void OnInitialized() => Ed.Changed += Update;
    void Update() => InvokeAsync(StateHasChanged);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ref = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("LM.initCanvas", _canvas, _ref);
        }
        if (Ed.EditingId != _focused)
        {
            _focused = Ed.EditingId;
            if (_focused is not null) await JS.InvokeVoidAsync("LM.focus", "#inline-text", Ed.EditSelectAll);
        }
        string? cell = Ed.CellTableId is null ? null : Ed.CellTableId + ":" + Ed.CellIndex;
        if (cell != _cell)
        {
            _cell = cell;
            if (cell is not null) await JS.InvokeVoidAsync("LM.focus", "#cell-text", true);
        }
    }

    void OnCellKey(KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "Escape": Ed.EndCellEdit(); break;
            case "Tab": Ed.MoveCell(e.ShiftKey ? -1 : 1); break;
            case "Enter": Ed.MoveCell(Ed.EditingTable?.Cols ?? 1); break;
        }
    }

    // An input laid over one cell, turning with the table about the table's centre.
    string CellStyle(TableNode t, int index)
    {
        var c = Ed.CellRect(t, index);
        double z = Ed.Zoom, line = Math.Max(t.Grid, t.Border), inset = line / 2;
        bool bold = t.Bold || (index < t.Cols && t.Header != TableHeader.None);
        FormattableString css = $"""
            left:{Ed.PanX + (t.X + c.X + inset) * z:0.##}px;top:{Ed.PanY + (t.Y + c.Y + inset) * z:0.##}px;
            width:{Math.Max(4, (c.W - line) * z):0.##}px;height:{Math.Max(4, (c.H - line) * z):0.##}px;
            padding:0 {t.Padding * z:0.##}px;
            font-family:'{t.FontFamily}','IBM Plex Sans',sans-serif;font-size:{Math.Max(1, c.Font * z):0.###}px;
            font-weight:{(bold ? 700 : 400)};font-style:{(t.Italic ? "italic" : "normal")};
            text-align:{t.Align.ToString().ToLowerInvariant()};color:#000;background:#fff;
            transform-origin:{(t.W / 2 - c.X - inset) * z:0.##}px {(t.H / 2 - c.Y - inset) * z:0.##}px;transform:rotate({t.Rotation:0.##}deg);
            """;
        return FormattableString.Invariant(css).ReplaceLineEndings("");
    }

    void OnEditKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Ed.EndEdit();
    }

    static string Decoration(TextNode t) => (t.Underline, t.Strike) switch
    {
        (true, true) => "underline line-through", (true, false) => "underline", (false, true) => "line-through", _ => "none",
    };

    // A textarea laid exactly over the text object: same box, font, size and rotation.
    string EditorStyle(TextNode t)
    {
        var m = ((IJSInProcessRuntime)JS).Invoke<double[]>("LM.textEditMetrics", t);
        double z = Ed.Zoom, pad = t.Padding * z;
        double inner = Math.Max(0, t.H - 2 * t.Padding), block = m[2];
        double off = t.Mode == TextMode.Auto ? 0 : t.VAlign switch { VAlign.Middle => (inner - block) / 2, VAlign.Bottom => inner - block, _ => 0 };
        // left-aligned hugging text gets room for the next character before the box catches up
        // hugging text: let the field size itself to what is typed (macros make the raw text longer than the printed one)
        string size = t.Mode == TextMode.Auto
            ? FormattableString.Invariant($"min-width:{t.W * z:0.##}px;min-height:{t.H * z:0.##}px;field-sizing:content;")
            : FormattableString.Invariant($"width:{t.W * z:0.##}px;height:{t.H * z:0.##}px;");
        if (t.Stacked)
        {
            // the browser's own upright vertical text, pitched to match the drawn letters
            double free = Math.Max(0, t.W - 2 * t.Padding - m[4]);
            double left = t.Align switch { HAlign.Center => free / 2, HAlign.Right => free, _ => 0 };
            FormattableString v = $"""
                left:{Ed.PanX + t.X * z:0.##}px;top:{Ed.PanY + t.Y * z:0.##}px;{size}
                padding:{pad + Math.Max(0, off) * z:0.##}px 0 0 {pad + left * z:0.##}px;
                writing-mode:vertical-lr;text-orientation:upright;white-space:pre;
                font-family:'{t.FontFamily}','IBM Plex Sans',sans-serif;font-size:{m[0] * z:0.###}px;line-height:{m[3] * z:0.###}px;
                font-weight:{(t.Bold ? 700 : 400)};font-style:{(t.Italic ? "italic" : "normal")};text-decoration:{Decoration(t)};letter-spacing:{t.LineHeight - 1:0.###}em;
                transform:rotate({t.Rotation:0.##}deg);color:{(t.Invert ? "#fff" : "#000")};background:{(t.Invert ? "#000" : "#fff")};
                """;
            return FormattableString.Invariant(v).ReplaceLineEndings("");
        }
        FormattableString css = $"""
            left:{Ed.PanX + t.X * z:0.##}px;top:{Ed.PanY + t.Y * z:0.##}px;{size}
            padding:{pad + Math.Max(0, off) * z:0.##}px {pad:0.##}px 0 {pad:0.##}px;
            font-family:'{t.FontFamily}','IBM Plex Sans',sans-serif;font-size:{m[0] * z:0.###}px;line-height:{m[1] * z:0.###}px;
            font-weight:{(t.Bold ? 700 : 400)};font-style:{(t.Italic ? "italic" : "normal")};text-decoration:{Decoration(t)};letter-spacing:{t.Tracking / 1000:0.###}em;
            text-align:{t.Align.ToString().ToLowerInvariant()};white-space:{(t.Mode == TextMode.Wrap ? "pre-wrap" : "pre")};
            transform:rotate({t.Rotation:0.##}deg);color:{(t.Invert ? "#fff" : "#000")};background:{(t.Invert ? "#000" : "#fff")};
            """;
        return FormattableString.Invariant(css).ReplaceLineEndings("");
    }

    [JSInvokable] public void OnCanvasResize(double w, double h) => Ed.CanvasResized(w, h);
    [JSInvokable] public void OnPointerDown(double x, double y, int button, int mods) => Ed.PointerDown(x, y, button, mods);
    [JSInvokable] public string OnPointerMove(double x, double y, int mods) => Ed.PointerMove(x, y, mods);
    [JSInvokable] public void OnPointerUp(double x, double y, int mods) => Ed.PointerUp(x, y, mods);
    [JSInvokable] public void OnDoubleClick(double x, double y) => Ed.DoubleClick(x, y);
    [JSInvokable] public void OnWheel(double x, double y, double dx, double dy, int mods) => Ed.Wheel(x, y, dx, dy, mods);
    [JSInvokable] public bool OnKey(string key, int mods) => Ed.Key(key, mods);
    [JSInvokable] public void OnPaste() => Ed.Paste();
    [JSInvokable] public void OnImageDropped(string dataUrl, double w, double h, double x, double y) => Ed.AddImage(dataUrl, w, h, x, y);

    [JSInvokable]
    public void OnFontsLoaded()
    {
        // late-arriving glyphs change text metrics
        Ed.Sync();
        Ed.Refresh();
    }

    public void Dispose()
    {
        Ed.Changed -= Update;
        _ref?.Dispose();
    }
}
