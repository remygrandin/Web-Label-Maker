@implements IDisposable
@inject PrinterService Printer
@inject Editor Ed
@inject Shell Shell
@inject Library Lib

<div class="scrim" @onclick="Shell.Close">
    <div class="dialog" @onclick:stopPropagation="true">
        <div class="dhead">
            <h2>Print</h2>
            <span class="grow"></span>
            <button class="ibtn" title="Close" @onclick="Shell.Close"><Icon Name="x" /></button>
        </div>
        <div class="dbody">
            <div class="print-grid">
                <div>
                    <div class="preview">
                        @if (_preview is not null)
                        {
                            <img src="@_preview" alt="1-bit print preview" style="width:@(PreviewWidth)px" />
                        }
                        else if (Printer.Geometry is null && _preview is null)
                        {
                            <div class="warn">@Printer.Model.Name cannot print on @Printer.Media.Label tape.</div>
                        }
                    </div>
                    <div class="hint">
                        Exactly the dots that will be sent. Tinted areas fall outside what this printer can reach on
                        @Printer.Media.Label tape, or inside its feed margins, and will not print.
                    </div>
                    @if (Printer.PreviewError is { } perr) { <div class="warn">@perr</div> }
                    @if (Printer.CutNote is { } note) { <div class="warn">@note</div> }
                    @if (Ed.UsesSeq) { <div class="hint">Counter: this run prints <b>@Ed.Doc.Counter.Value</b> onwards, one step per copy.</div> }
                    <div class="kv" style="margin-top:12px">
                        <span>Label</span><b>@F(Ed.Doc.WidthMm) × @F(Ed.Doc.HeightMm) mm</b>
                        <span>Resolution</span><b>@Printer.Model.Dpi dpi</b>
                        @if (Printer.Geometry is { } g)
                        {
                            <span>Printed band</span><b>@g.PrintPins dots · @F(g.PrintPins * 25.4 / Printer.Model.Dpi) mm</b>
                        }
                    </div>
                    @if (Printer.Log.Count > 0)
                    {
                        <div class="log" style="margin-top:12px">@string.Join("\n", Enumerable.Reverse(Printer.Log).Take(8))</div>
                    }
                </div>

                <div>
                    <div class="sect-title">Printer</div>
                    <select class="sel" value="@Printer.Model.Id" @onchange="SetModel">
                        @foreach (var m in Brother.Models)
                        {
                            <option value="@m.Id">@m.Name</option>
                        }
                    </select>
                    <div class="@(Printer.Model.Verified ? "hint" : "warn")">@Printer.Model.Note</div>

                    @if (!Printer.Supported)
                    {
                        <div class="warn" style="margin-top:12px">
                            This browser has no Web Serial support. Use Chrome, Edge or Opera on a desktop computer to print;
                            you can still export the label as a PNG.
                        </div>
                    }
                    else
                    {
                        <div class="conn @(Printer.Connected ? "on" : "")" style="margin-top:12px">
                            <i class="led"></i>
                            <div class="t">
                                @(Printer.Connected ? Printer.PortInfo : "Not connected")
                                <small>@(Printer.Status is { } s ? $"{s.MediaWidth} tape loaded" : Printer.Connected ? "no status yet" : "pair the printer in your OS first")</small>
                            </div>
                            @if (Printer.Connected)
                            {
                                <button class="btn sm" @onclick="Printer.Disconnect">Disconnect</button>
                            }
                            else
                            {
                                <button class="btn sm solid" @onclick="Printer.Connect">Connect…</button>
                            }
                        </div>
                        @if (!Printer.Connected)
                        {
                            <div class="hint">
                                Pair the printer over Bluetooth in your system settings, then pick its serial (COM) port here.
                            </div>
                        }
                        @if (TapeMismatch)
                        {
                            <div class="warn">The printer holds @Printer.Status!.MediaWidth tape; this label is laid out for @Printer.Media.Label.</div>
                        }
                    }

                    <div class="sect-title" style="margin-top:16px">Options</div>
                    <div class="row">
                        <span class="lbl">Copies</span>
                        <div class="fill"><NumberField Value="O.Copies" Min="1" Max="99" Step="1" Decimals="0" ValueChanged="v => O.Copies = (int)v" /></div>
                    </div>
                    <div class="row">
                        <span class="lbl">Feed</span>
                        <div class="fill">
                            <NumberField Unit="mm" Value="O.FeedMm" Min="@MinFeed" Max="60" Step="0.5" Decimals="1" Title="Blank tape before and after the printed area"
                                         ValueChanged="async v => { O.FeedMm = v; await Refresh(); }" />
                        </div>
                    </div>
                    @if (Printer.Model.AutoCut)
                    {
                        <div class="row">
                            <label class="check"><input type="checkbox" checked="@O.AutoCut" @onchange="e => O.AutoCut = (bool)e.Value!" /><i></i>Cut after each label</label>
                        </div>
                    }
                    @if (Printer.Model.HalfCut)
                    {
                        <div class="row">
                            <label class="check"><input type="checkbox" checked="@O.HalfCut" @onchange="e => O.HalfCut = (bool)e.Value!" /><i></i>Half cut (easy peel)</label>
                        </div>
                    }
                    <div class="row">
                        <label class="check" title="The last label stays in the printer until the next job, saving the leader tape">
                            <input type="checkbox" checked="@O.Chain" @onchange="e => O.Chain = (bool)e.Value!" /><i></i>Chain print (no final feed)
                        </label>
                    </div>
                    <div class="row">
                        <span class="lbl">Offset</span>
                        <div class="fill">
                            <NumberField Unit="dots" Value="O.PinOffset" Min="-64" Max="64" Step="1" Decimals="0" Title="Shift the print across the tape if it sits off-centre"
                                         ValueChanged="v => O.PinOffset = (int)v" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="dfoot">
            <button class="btn" @onclick="Lib.ExportPng"><Icon Name="image" />Export PNG</button>
            <span class="grow"></span>
            @if (TapeMismatch)
            {
                <button class="btn" disabled="@(!CanPrint)" @onclick="() => Printer.Print(ignoreTapeCheck: true)">Print anyway</button>
            }
            <button class="btn primary" disabled="@(!CanPrint)" @onclick="() => Printer.Print()">
                <Icon Name="printer" />@(Printer.Busy ? "Printing…" : "Print")
            </button>
        </div>
    </div>
</div>

@code {
    string? _preview;

    PrintOptions O => Printer.Options;
    bool CanPrint => Printer.Supported && Printer.Connected && !Printer.Busy && Printer.Geometry is not null;
    bool TapeMismatch => Printer.Status is { } s && s.MediaWidthCode != 0 && s.MediaWidthCode != Printer.Media.WidthCode;
    double MinFeed => Math.Round(14 * 25.4 / Printer.Model.Dpi, 1);

    // show the dots at an integer scale that fits the dialog
    int PreviewWidth
    {
        get
        {
            double dots = Ed.Doc.WidthMm * Printer.Model.Dpi / 25.4;
            int scale = Math.Max(1, (int)Math.Floor(560 / dots));
            return (int)Math.Round(dots * Math.Min(scale, 3));
        }
    }

    static string F(double v) => v.ToString("0.#", CultureInfo.InvariantCulture);

    protected override async Task OnInitializedAsync()
    {
        Printer.Changed += Update;
        if (Math.Abs(Ed.Doc.Dpi - Printer.Model.Dpi) > 0.5) Printer.SetModel(Printer.Model.Id);
        await Printer.Init();
        await Refresh();
    }

    async Task Refresh()
    {
        _preview = await Printer.Preview();
        StateHasChanged();
    }

    async Task SetModel(ChangeEventArgs e)
    {
        Printer.SetModel(e.Value!.ToString()!);
        await Refresh();
    }

    void Update() => InvokeAsync(StateHasChanged);
    public void Dispose() => Printer.Changed -= Update;
}
