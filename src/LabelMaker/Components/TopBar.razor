@inherits EditorComponent
@inject Library Lib

<header class="topbar">
    <div class="brand"><Icon Name="tape" /></div>
    <span class="wordmark">WEB LABEL MAKER</span>
    @ChildContent
    <span class="top-sep"></span>
    <input class="docname" value="@Ed.Doc.Name" spellcheck="false" title="Label name"
           @onchange="e => Rename(e.Value?.ToString())" />
    @if (Lib.SaveError is { } error)
    {
        <span class="autosave failed" title="@error"><i></i>@error</span>
    }
    else
    {
        <span class="autosave @(Lib.Pending ? "pending" : "")" title="@SaveTip">
            <i></i>@(Lib.Pending ? "Saving…" : Lib.SavedAt is { } at ? $"Autosaved {at:HH:mm:ss}" : "Autosave on")@(Lib.InLibrary ? " · in library" : "")
        </span>
    }
    <span class="top-spacer"></span>
    <button class="ibtn" title="Undo (Ctrl+Z)" disabled="@(!Ed.CanUndo)" @onclick="Ed.Undo"><Icon Name="undo" /></button>
    <button class="ibtn" title="Redo (Ctrl+Y)" disabled="@(!Ed.CanRedo)" @onclick="Ed.Redo"><Icon Name="redo" /></button>
    <span class="top-sep"></span>
    <button class="ibtn" title="Theme: @Shell.Settings.Theme" @onclick="Shell.CycleTheme"><Icon Name="@ThemeIcon" /></button>
    @Actions
</header>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }

    string SaveTip => Lib.InLibrary
        ? "Every change is saved automatically, both as the working label and to its entry in the library."
        : "Every change is saved automatically in this browser. Use File → Save to library to keep it as a named label.";

    protected override void OnInitialized()
    {
        base.OnInitialized();
        Lib.StateChanged += Update;
    }

    public override void Dispose()
    {
        base.Dispose();
        Lib.StateChanged -= Update;
    }

    string ThemeIcon => Shell.Settings.Theme switch { "light" => "sun", "dark" => "moon", _ => "system" };

    void Rename(string? name)
    {
        name = string.IsNullOrWhiteSpace(name) ? "Untitled label" : name.Trim();
        if (name == Ed.Doc.Name) return;
        Ed.Doc.Name = name;
        Ed.Touch();
    }
}
