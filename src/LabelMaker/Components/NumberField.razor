<label class="num @(Disabled ? "off" : "")" title="@Title">
    @if (Label is not null)
    {
        <span class="num-l">@Label</span>
    }
    <input @key="_rev" value="@Format(Value)" inputmode="decimal" spellcheck="false" autocomplete="off"
           @onchange="Commit" @onkeydown="KeyDown" disabled="@Disabled" />
    @if (Unit is not null)
    {
        <span class="num-u">@Unit</span>
    }
    @if (Spin)
    {
        <span class="num-spin">
            <button type="button" tabindex="-1" title="More" disabled="@(Disabled || Value >= Max)" @onclick="() => Nudge(1)" @onclick:preventDefault="true">
                <svg viewBox="0 0 8 5" aria-hidden="true"><path d="M1 4l3-3 3 3" /></svg>
            </button>
            <button type="button" tabindex="-1" title="Less" disabled="@(Disabled || Value <= Min)" @onclick="() => Nudge(-1)" @onclick:preventDefault="true">
                <svg viewBox="0 0 8 5" aria-hidden="true"><path d="M1 1l3 3 3-3" /></svg>
            </button>
        </span>
    }
</label>

@code {
    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Unit { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public double Min { get; set; } = double.MinValue;
    [Parameter] public double Max { get; set; } = double.MaxValue;
    [Parameter] public double Step { get; set; } = 1;
    [Parameter] public int Decimals { get; set; } = 2;
    [Parameter] public bool Disabled { get; set; }
    /// <summary>Show small up and down arrows after the number.</summary>
    [Parameter] public bool Spin { get; set; }

    int _rev;

    Task Nudge(int direction)
    {
        _rev++;
        return Set(Value + direction * Step);
    }

    string Format(double v) => Math.Round(v, Decimals).ToString("0." + new string('#', Decimals), CultureInfo.InvariantCulture);

    async Task Commit(ChangeEventArgs e)
    {
        var raw = (e.Value?.ToString() ?? "").Trim().Replace(',', '.');
        _rev++; // re-create the input so it shows the normalised value
        if (double.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var v) && double.IsFinite(v))
            await Set(v);
    }

    async Task KeyDown(KeyboardEventArgs e)
    {
        if (e.Key is not ("ArrowUp" or "ArrowDown")) return;
        double step = Step * (e.ShiftKey ? 10 : 1);
        _rev++;
        await Set(Value + (e.Key == "ArrowUp" ? step : -step));
    }

    Task Set(double v)
    {
        v = Math.Clamp(Math.Round(v, Decimals + 2), Min, Max);
        return v == Value ? Task.CompletedTask : ValueChanged.InvokeAsync(v);
    }
}
