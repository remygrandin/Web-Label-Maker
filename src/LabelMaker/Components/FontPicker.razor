@inject Editor Ed
@inject Shell Shell
@inject IJSRuntime JS

<button class="fontbtn" @ref="_button" @onclick="Toggle" title="Font family">
    <span style="font-family:'@Value',var(--sans)">@Value</span>
    <Icon Name="chev-down" />
</button>

@if (_open)
{
    <div class="menu-scrim" @onclick="() => _open = false"></div>
    <div class="fontpop" style="top:@(_top.ToString("0", CultureInfo.InvariantCulture))px">
        <div class="search">
            <input id="font-search" class="inp" placeholder="Search, or type any Google Fonts name" autocomplete="off" spellcheck="false"
                   value="@_query" @oninput="e => _query = e.Value?.ToString() ?? string.Empty" @onkeydown="SearchKey" />
        </div>
        <div class="fontlist">
            @if (_busy is not null)
            {
                <div class="menu-head">Loading @_busy…</div>
            }
            @if (Query.Length == 0)
            {
                @if (InDocument.Count > 0)
                {
                    <div class="menu-head">In this label</div>
                    @foreach (var f in InDocument) { @Option(f, true) }
                }
                @if (Recent.Count > 0)
                {
                    <div class="menu-head">Recent</div>
                    @foreach (var f in Recent) { @Option(f, false) }
                }
                @foreach (var (group, families) in FontCatalog.Curated)
                {
                    <div class="menu-head">@group</div>
                    @foreach (var f in families) { @Option(f, true) }
                }
            }
            else
            {
                var hits = Matches;
                @foreach (var f in hits) { @Option(f, FontCatalog.AllCurated.Contains(f)) }
                @if (!hits.Any(h => h.Equals(Query, StringComparison.OrdinalIgnoreCase)))
                {
                    <div class="menu-rule"></div>
                    <button class="fontopt" @onclick="() => Pick(TitleCase(Query))">
                        Load “@TitleCase(Query)”<small>Google Fonts</small>
                    </button>
                }
            }
        </div>
    </div>
}

@code {
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    ElementReference _button;
    bool _open, _focus;
    double _top;
    string _query = "";
    string? _busy;

    string Query => _query.Trim();
    List<string> InDocument => Editor.Fonts(Ed.All()).OrderBy(f => f).ToList();
    List<string> Recent => Shell.Settings.RecentFonts.Except(InDocument).Take(6).ToList();

    IEnumerable<string> Matches => FontCatalog.AllCurated.Concat(FontCatalog.More).Concat(Shell.Settings.RecentFonts).Distinct()
        .Where(f => f.Contains(Query, StringComparison.OrdinalIgnoreCase))
        .OrderBy(f => f.StartsWith(Query, StringComparison.OrdinalIgnoreCase) ? 0 : 1).ThenBy(f => f).Take(40);

    RenderFragment Option(string family, bool preview) => @<button class="fontopt @(family == Value ? "on" : "")" @onclick="() => Pick(family)"
        style="@(preview ? $"font-family:'{family}',var(--sans)" : "")">@family</button>;

    static string TitleCase(string s) => string.Join(' ', s.Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Select(w => w.Length > 3 || char.IsLower(w[0]) ? char.ToUpperInvariant(w[0]) + w[1..] : w));

    async Task Toggle()
    {
        _open = !_open;
        if (!_open) return;
        _query = "";
        var r = await JS.InvokeAsync<double[]>("LM.rectOf", _button);
        _top = Math.Max(48, Math.Min(r[1] + r[3] + 2, 9999));
        _focus = true;
        // previews: fetch the curated set in the background
        foreach (var f in FontCatalog.AllCurated) _ = Ed.LoadFont(f);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focus) return;
        _focus = false;
        await JS.InvokeVoidAsync("LM.focus", "#font-search", false);
    }

    async Task SearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _open = false;
        else if (e.Key == "Enter" && Query.Length > 0) await Pick(Matches.FirstOrDefault() ?? TitleCase(Query));
    }

    async Task Pick(string family)
    {
        _busy = family;
        StateHasChanged();
        bool ok = await Ed.LoadFont(family);
        _busy = null;
        if (!ok)
        {
            Shell.Toast($"“{family}” was not found on Google Fonts.");
            return;
        }
        _open = false;
        var recent = Shell.Settings.RecentFonts;
        recent.Remove(family);
        recent.Insert(0, family);
        if (recent.Count > 12) recent.RemoveRange(12, recent.Count - 12);
        Shell.SaveSettings();
        await ValueChanged.InvokeAsync(family);
    }
}
