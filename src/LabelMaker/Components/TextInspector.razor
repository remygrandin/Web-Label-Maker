@inject Editor Ed

<div class="sect">
    <div class="sect-title">
        Text
        <span class="grow"></span>
        <InsertMacro OnInsert="m => Ed.Mutate(() => Node.Text += m)" />
    </div>
    <textarea id="text-content" class="area" spellcheck="false" rows="3" value="@Node.Text"
              @oninput="e => Ed.Mutate(() => Node.Text = e.Value?.ToString() ?? string.Empty, TextKey)"></textarea>
    @if (Node.Text.Contains('{'))
    {
        <div class="hint">Prints as: <b style="color:var(--ink)">@Ed.ResolveText(Node.Text)</b></div>
    }
    <div class="row">
        <div class="fill"><FontPicker Value="@Node.FontFamily" ValueChanged="f => Ed.Mutate(() => Node.FontFamily = f)" /></div>
    </div>
    <div class="row">
        <div class="fill">
            <BoundField Node="Node" Prop="FontSize" Unit="pt" Min="2" Max="400" Step="0.5" Decimals="1" Disabled="Node.Mode == TextMode.Fit" Title="Font size" />
        </div>
        <div class="seg">
            <button class="size-step" disabled="@SizeFixed" title="@(SizeBound ? "The size is set by an expression" : "Smaller text")" @onclick="() => Resize(-1)">A−</button>
            <button class="size-step big" disabled="@SizeFixed" title="@(SizeBound ? "The size is set by an expression" : "Bigger text")" @onclick="() => Resize(1)">A+</button>
        </div>
    </div>
    <div class="row">
        <span class="lbl">Style</span>
        <div class="seg">
            <button class="@(Node.Bold ? "on" : "")" title="Bold" @onclick="() => Ed.Mutate(() => Node.Bold = !Node.Bold)"><Icon Name="bold" /></button>
            <button class="@(Node.Italic ? "on" : "")" title="Italic" @onclick="() => Ed.Mutate(() => Node.Italic = !Node.Italic)"><Icon Name="italic" /></button>
            <button class="@(Node.Underline ? "on" : "")" title="Underline" @onclick="() => Ed.Mutate(() => Node.Underline = !Node.Underline)"><Icon Name="underline" /></button>
            <button class="@(Node.Strike ? "on" : "")" title="Strikethrough" @onclick="() => Ed.Mutate(() => Node.Strike = !Node.Strike)"><Icon Name="strike" /></button>
        </div>
    </div>
    <div class="row">
        <span class="lbl">Align</span>
        <div class="seg">
            <button class="@(Node.Align == HAlign.Left ? "on" : "")" title="Align left" @onclick="() => Ed.Mutate(() => Node.Align = HAlign.Left)"><Icon Name="text-left" /></button>
            <button class="@(Node.Align == HAlign.Center ? "on" : "")" title="Centre" @onclick="() => Ed.Mutate(() => Node.Align = HAlign.Center)"><Icon Name="text-center" /></button>
            <button class="@(Node.Align == HAlign.Right ? "on" : "")" title="Align right" @onclick="() => Ed.Mutate(() => Node.Align = HAlign.Right)"><Icon Name="text-right" /></button>
        </div>
        <div class="seg">
            <button class="@(Node.VAlign == VAlign.Top ? "on" : "")" title="@VTip("Top")" @onclick="() => Ed.Mutate(() => Node.VAlign = VAlign.Top)"><Icon Name="valign-top" /></button>
            <button class="@(Node.VAlign == VAlign.Middle ? "on" : "")" title="@VTip("Middle")" @onclick="() => Ed.Mutate(() => Node.VAlign = VAlign.Middle)"><Icon Name="valign-mid" /></button>
            <button class="@(Node.VAlign == VAlign.Bottom ? "on" : "")" title="@VTip("Bottom")" @onclick="() => Ed.Mutate(() => Node.VAlign = VAlign.Bottom)"><Icon Name="valign-bot" /></button>
        </div>
    </div>
    <div class="row">
        <span class="lbl">Letters</span>
        <div class="seg fill">
            <button class="@(Node.Stacked ? "" : "on")" title="Letters side by side, as usual" @onclick="() => Ed.Mutate(() => Node.Stacked = false)">In a row</button>
            <button class="@(Node.Stacked ? "on" : "")" title="Upright letters one above the other; each line of text becomes a column" @onclick="() => Ed.Mutate(() => Node.Stacked = true)">Stacked</button>
        </div>
    </div>
    <div class="row">
        <span class="lbl">Width</span>
        <div class="seg fill">
            <button class="@(Node.Mode == TextMode.Auto ? "on" : "")" title="The box grows and shrinks with the text" @onclick="() => SetMode(TextMode.Auto)">Auto</button>
            <button class="@(Node.Mode != TextMode.Auto ? "on" : "")" title="The box keeps the size you give it" @onclick="() => SetMode(Node.Mode == TextMode.Auto ? TextMode.Wrap : Node.Mode)">Fixed</button>
        </div>
    </div>
    @if (Node.Mode != TextMode.Auto)
    {
        <div class="row">
            <span class="lbl">If too long</span>
            <div class="seg fill">
                <button class="@(Node.Mode == TextMode.Wrap ? "on" : "")" title="@(Node.Stacked ? "Stacked letters do not wrap; the font size stays" : "Break onto new lines at the box edge; the font size stays")" @onclick="() => SetMode(TextMode.Wrap)">Line break</button>
                <button class="@(Node.Mode == TextMode.Fit ? "on" : "")" title="Scale the text so it always fills the box" @onclick="() => SetMode(TextMode.Fit)">Fit size</button>
            </div>
        </div>
    }
    <div class="grid2" style="margin-top:6px">
        <BoundField Node="Node" Prop="LineHeight" Label="LH" Min="0.6" Max="3" Step="0.05" Title="Line height" />
        <BoundField Node="Node" Prop="Tracking" Label="TR" Min="-200" Max="1000" Step="10" Decimals="0" Title="Letter spacing (1/1000 em)" />
    </div>
    <div class="row">
        <label class="check fill">
            <input type="checkbox" checked="@Node.Invert" @onchange="e => Ed.Mutate(() => Node.Invert = (bool)e.Value!)" /><i></i>
            White on black
        </label>
        <div style="width:96px">
            <BoundField Node="Node" Prop="Padding" Label="PAD" Unit="mm" Min="0" Max="20" Step="0.25" Title="Inner padding" />
        </div>
    </div>
    <div class="hint">Double-click the text on the label to edit it in place.</div>
</div>

@code {
    [Parameter, EditorRequired] public TextNode Node { get; set; } = default!;

    string TextKey => "text:" + Node.Id;

    // In a fixed box this places the text inside it; a box that follows the text grows from that edge instead.
    string VTip(string where) => Node.Mode == TextMode.Auto
        ? $"{where}: the box grows from its {(where == "Middle" ? "middle" : where == "Top" ? "top edge" : "bottom edge")} as the text changes"
        : $"{where} of the box";

    // A size driven by an expression is left alone: the buttons must not replace the expression.
    bool SizeBound => Editor.BindingOf(Node, "FontSize") is not null;
    bool SizeFixed => Node.Mode == TextMode.Fit || SizeBound;

    // One step bigger or smaller: finer steps for small text, coarser for large.
    void Resize(int direction)
    {
        if (SizeFixed) return;
        double size = Node.FontSize;
        double from = direction < 0 ? size - 0.01 : size; // going down from 12 uses the small step
        double step = from < 12 ? 1 : from < 36 ? 2 : 4;
        double next = Math.Clamp(Math.Round((size + direction * step) * 2) / 2, 2, 400);
        Ed.Mutate(() => Node.FontSize = next, "font-step:" + Node.Id);
    }

    void SetMode(TextMode mode) => Ed.Mutate(() => Node.Mode = mode);
}
