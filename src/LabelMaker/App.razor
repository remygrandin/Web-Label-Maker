@implements IDisposable
@inject Shell Shell
@inject Editor Ed

<div class="app">
    <TopBar />
    <ToolRail />
    <LayersPanel />
    <CanvasView />
    <Inspector />
    <StatusBar />
</div>

@if (Shell.ToastText is { } toast)
{
    <div class="toast">@toast</div>
}

@code {
    protected override void OnInitialized() => Shell.Changed += Update;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Ed.Load(Ed.Doc);
    }

    void Update() => InvokeAsync(StateHasChanged);
    public void Dispose() => Shell.Changed -= Update;
}
