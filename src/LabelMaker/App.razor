@implements IDisposable
@inject Shell Shell
@inject Library Lib

<div class="app">
    <TopBar>
        <ChildContent><FileMenu /></ChildContent>
        <Actions>
            <button class="btn" title="Saved labels and templates" @onclick="() => Shell.Open(Dialog.Library)"><Icon Name="folder" />Library</button>
            <button class="btn primary" title="Preview and print" @onclick="() => Shell.Open(Dialog.Print)"><Icon Name="printer" />Print</button>
        </Actions>
    </TopBar>
    <ToolRail />
    <LayersPanel />
    <CanvasView />
    <Inspector />
    <StatusBar />
</div>

@if (Shell.Dialog is Dialog.Library or Dialog.Templates)
{
    <LibraryDialog @key="Shell.Dialog" />
}

@if (Shell.Dialog == Dialog.Print)
{
    <PrintDialog />
}

@if (Shell.ToastText is { } toast)
{
    <div class="toast">@toast</div>
}

@code {
    protected override void OnInitialized() => Shell.Changed += Update;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Lib.Restore();
    }

    void Update() => InvokeAsync(StateHasChanged);
    public void Dispose() => Shell.Changed -= Update;
}
