@implements IDisposable
@inject Shell Shell
@inject Library Lib
@inject PrinterService Printer

<div class="app">
    <TopBar>
        <ChildContent><FileMenu /></ChildContent>
        <Actions>
            <PrinterChip />
            <button class="btn" title="Saved labels and templates" @onclick="() => Shell.Open(Dialog.Library)"><Icon Name="folder" />Library</button>
            <button class="btn primary" title="Preview and print" @onclick="() => Shell.Open(Dialog.Print)"><Icon Name="printer" />Print</button>
        </Actions>
    </TopBar>
    <ToolRail />
    <LayersPanel />
    <CanvasView />
    <Inspector />
    <StatusBar />
</div>

@if (Shell.Dialog is Dialog.Library or Dialog.Templates)
{
    <LibraryDialog @key="Shell.Dialog" />
}

@if (Shell.Dialog is Dialog.Images or Dialog.Icons)
{
    <ImageDialog @key="Shell.Dialog" />
}

@if (Shell.Dialog == Dialog.Print)
{
    <PrintDialog />
}

@if (Shell.Asking is { } q)
{
    <div class="scrim" style="z-index:80">
        <div class="dialog narrow">
            <div class="dhead">
                <h2>@q.Title</h2>
                <span class="grow"></span>
                <button class="ibtn" title="Cancel" @onclick="() => Shell.Answer(-1)"><Icon Name="x" /></button>
            </div>
            <div class="dbody" style="line-height:1.5">@q.Text</div>
            <div class="dfoot">
                <span class="grow"></span>
                @for (int i = q.Options.Length - 1; i >= 0; i--)
                {
                    int option = i;
                    <button class="btn @(option == 0 ? "primary" : "")" @onclick="() => Shell.Answer(option)">@q.Options[option]</button>
                }
            </div>
        </div>
    </div>
}

@if (Shell.ToastText is { } toast)
{
    <div class="toast">@toast</div>
}

@code {
    protected override void OnInitialized() => Shell.Changed += Update;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Lib.Restore();
            _ = Printer.Init(); // reopen the last printer port in the background
        }
    }

    void Update() => InvokeAsync(StateHasChanged);
    public void Dispose() => Shell.Changed -= Update;
}
