@implements IDisposable
@inject Shell Shell

<div class="app">
    <header class="topbar">
        <div class="brand"><Icon Name="tape" /></div>
        <span class="wordmark">LABELBENCH</span>
        <span class="top-spacer"></span>
        <button class="ibtn" title="Theme: @Shell.Settings.Theme" @onclick="Shell.CycleTheme">
            <Icon Name="@ThemeIcon" />
        </button>
    </header>
    <nav class="rail"></nav>
    <aside class="panel layers"></aside>
    <main class="stage"></main>
    <aside class="panel insp"></aside>
    <footer class="status"></footer>
</div>

@if (Shell.ToastText is { } toast)
{
    <div class="toast">@toast</div>
}

@code {
    string ThemeIcon => Shell.Settings.Theme switch { "light" => "sun", "dark" => "moon", _ => "system" };

    protected override void OnInitialized() => Shell.Changed += StateHasChanged;
    public void Dispose() => Shell.Changed -= StateHasChanged;
}
